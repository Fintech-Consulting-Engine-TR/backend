NODE_ENV=development
HOST=127.0.0.1
PORT=3000
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=info
SHUTDOWN_TIMEOUT_MS=10000

# Optional for HTTP-only local mode; required for database commands / Compose.
# Replace CHANGE_ME locally; URL-encode the password in URLs.
POSTGRES_USER=fintech
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=fintech
DB_PORT=5432
DATABASE_URL=postgresql://fintech:CHANGE_ME@127.0.0.1:5432/fintech
DOCKER_DATABASE_URL=postgresql://fintech:CHANGE_ME@db:5432/fintech

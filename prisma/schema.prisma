generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  admin
  user
  @@map("role")
}

model User {
  id            String   @id @default(uuid()) @db.Uuid
  email         String   @unique
  password_hash String
  role          Role     @default(user)
  created_at    DateTime @default(now()) @db.Timestamptz(3)
  createdCompanies Company[] @relation("CompanyCreator")
  responsibleCompanies Company[] @relation("CompanyResponsible")
  createdContacts Contact[] @relation("ContactCreator")
  responsibleContacts Contact[] @relation("ContactResponsible")
  @@map("users")
}

model Company {
  id                String   @id @default(uuid()) @db.Uuid
  name              String
  industry          String?
  website           String?
  custom            Json     @default("{}")
  createdById       String?  @db.Uuid
  responsibleUserId String?  @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy         User?    @relation("CompanyCreator", fields: [createdById], references: [id], onDelete: Restrict)
  responsibleUser   User?    @relation("CompanyResponsible", fields: [responsibleUserId], references: [id], onDelete: Restrict)
  contacts          Contact[]
  @@index([createdById])
  @@index([responsibleUserId])
  @@map("companies")
}

model Contact {
  id                String   @id @default(uuid()) @db.Uuid
  // Legacy full names are preserved verbatim; do not guess their first/last-name split.
  full_name         String
  firstName         String?  @db.VarChar(100)
  lastName          String?  @db.VarChar(100)
  position          String?
  email             String?  @unique
  phone             String?
  custom            Json     @default("{}")
  companyId         String   @map("company_id") @db.Uuid
  createdById       String?  @db.Uuid
  responsibleUserId String?  @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  company           Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  createdBy         User?    @relation("ContactCreator", fields: [createdById], references: [id], onDelete: Restrict)
  responsibleUser   User?    @relation("ContactResponsible", fields: [responsibleUserId], references: [id], onDelete: Restrict)
  @@index([companyId])
  @@index([createdById])
  @@index([responsibleUserId])
  @@map("contacts")
}
